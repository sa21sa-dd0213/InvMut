 "change_summary": "Replace the balance reset with an increment of 1 so a leftover balance of 1 remains after withdrawal.",
 "mutated_unit_code": "function withdrawBalance()  public nonReentrant_ {\n\n     { (bool _s, bytes memory _d) = msg.sender.call{value: userBalance[msg.sender]}(\"\"); _d; if (! _s) {\n         revert();\n     } }\n     userBalance[msg.sender] += 1;\n }",
 "esbmc_test_source": "contract InvMutTest {\n    C c;\n    constructor() { c = new C(); }\n    function __ESBMC_reverted() internal returns (bool) {}\n    function __ESBMC_assume(bool) internal pure {}\n\n    function test(uint256 amount) external { __ESBMC_assume(address(c).balance >= 1000000000000000000000000); require(address(this).balance >= (amount)); require(amount <= 1000000000000000000000000000000);\n        require(address(this).balance >= amount);\n        c.addToBalance{value: amount}(); if (__ESBMC_reverted()) return;\n        c.withdrawBalance(); if (__ESBMC_reverted()) return;\n        assert(c.getBalance(address(this)) == 0);\n    }\n\n    receive() external payable {}\n    fallback() external payable {}\n}",
 "rendered_test": "// SPDX-License-Identifier: UNLICENSED\npragma solidity ^0.8.0;\n\nimport {Test} from \"forge-std/Test.sol\";\nimport {Reentrance} from \"../src/Reentrance.sol\";\n\ncontract InvMutTest is Test {\n    uint256 internal constant VALUE_CAP = 1000000000000000000000000000000;\n    Reentrance c;\n\n    function setUp() public {\n        c = new Reentrance();\n    }\n\n    function _test(uint256 amount) internal {\n        amount = bound(amount, 0, 1000000000000000000000000000000);\n        vm.deal(address(this), VALUE_CAP);\n        vm.deal(address(c), VALUE_CAP);\n        vm.assume(address(this).balance >= amount);\n        try c.addToBalance{value: amount}() {} catch { return; }\n        try c.withdrawBalance() {} catch { return; }\n        assertTrue(c.getBalance(address(this)) == 0);\n    }\n\n    function testFuzz_test(uint256 amount) public {\n        _test(amount);\n    }\n\n    receive() external payable {}\n\n    fallback() external payable {}\n}\n",
