 "rendered_test": "// SPDX-License-Identifier: UNLICENSED\npragma solidity ^0.8.0;\nimport {Test} from \"forge-std/Test.sol\";\nimport {MONEY_BOX} from \"../src/MONEY_BOX.sol\";\n\ncontract InvMutTest is Test {\n    MONEY_BOX c;\n    function setUp() public { c = new MONEY_BOX(); }\n    function testFuzz_property(uint256 v1, uint256 v2, address actor) public {\n        vm.assume(actor != address(0));\n        vm.assume(v1 != v2);\n        vm.prank(actor);\n        c.SetMinSum(v1);\n        vm.prank(actor);\n        c.SetMinSum(v2);\n        assertTrue(c.MinSum() == v2);\n    }\n}",
