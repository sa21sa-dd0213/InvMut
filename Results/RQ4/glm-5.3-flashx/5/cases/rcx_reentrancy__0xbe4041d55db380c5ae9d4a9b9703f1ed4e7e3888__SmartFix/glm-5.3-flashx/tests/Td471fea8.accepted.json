 "rendered_test": "// SPDX-License-Identifier: UNLICENSED\npragma solidity ^0.8.0;\nimport {Test} from \"forge-std/Test.sol\";\nimport {MONEY_BOX} from \"../src/MONEY_BOX.sol\";\n\ncontract InvMutTest is Test {\n    MONEY_BOX c;\n    function setUp() public { c = new MONEY_BOX(); }\n\n    function testFuzz_property(uint256 amount, address actor) public {\n        vm.assume(amount < type(uint256).max);\n        vm.assume(actor != address(0));\n        vm.prank(actor);\n        bool ok;\n        try c.SetMinSum(amount) { ok = true; } catch { ok = false; }\n        assertTrue(!ok || c.MinSum() == amount);\n    }\n}",
