 "rendered_test": "// SPDX-License-Identifier: UNLICENSED\npragma solidity ^0.8.0;\nimport {Test} from \"forge-std/Test.sol\";\nimport {Owned} from \"../src/Owned.sol\";\n\ncontract InvMutTest is Test {\n    Owned c;\n    function setUp() public { c = new Owned(); }\n    function testFuzz_property(address caller, address newOwner) public {\n        vm.assume(caller != address(0));\n        vm.assume(caller != c.owner());\n        address oldOwner = c.owner();\n        bool ok;\n        vm.prank(caller);\n        try c.transferOwnership(newOwner) { ok = true; } catch { ok = false; }\n        assertTrue(!ok && c.owner() == oldOwner);\n    }\n}\n",
