 "rendered_test": "// SPDX-License-Identifier: UNLICENSED\npragma solidity ^0.8.0;\nimport {Test} from \"forge-std/Test.sol\";\nimport {ACCURAL_DEPOSIT} from \"../src/ACCURAL_DEPOSIT.sol\";\n\ncontract InvMutTest is Test {\n    ACCURAL_DEPOSIT c;\n    function setUp() public { c = new ACCURAL_DEPOSIT(); }\n    function testFuzz_property(uint256 val) public {\n        val = bound(val, 1, type(uint256).max / 2);\n        c.SetMinSum(val);\n        assertTrue(c.MinSum() == val, \"SetMinSum must overwrite MinSum with _val\");\n    }\n}\n",
