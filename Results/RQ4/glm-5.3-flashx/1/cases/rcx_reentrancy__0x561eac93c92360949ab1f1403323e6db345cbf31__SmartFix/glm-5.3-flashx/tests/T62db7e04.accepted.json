 "rendered_test": "// SPDX-License-Identifier: UNLICENSED\npragma solidity ^0.8.0;\nimport {Test} from \"forge-std/Test.sol\";\nimport {BANK_SAFE} from \"../src/BANK_SAFE.sol\";\n\ncontract InvMutTest is Test {\n    BANK_SAFE c;\n    function setUp() public { c = new BANK_SAFE(); }\n    function testFuzz_property(uint256 initVal, uint256 newVal, address actor) public {\n        vm.assume(actor != address(0));\n        c.SetMinSum(initVal);\n        c.Initialized();\n        uint256 before = c.MinSum();\n        vm.prank(actor);\n        bool ok;\n        try c.SetMinSum(newVal) { ok = true; } catch { ok = false; }\n        assertTrue(!ok && c.MinSum() == before);\n    }\n}\n",
