 "rendered_test": "// SPDX-License-Identifier: UNLICENSED\npragma solidity ^0.8.0;\nimport {Test} from \"forge-std/Test.sol\";\nimport {Owned} from \"../src/Owned.sol\";\n\ncontract InvMutTest is Test {\n    Owned c;\n    function setUp() public { c = new Owned(); }\n    function testFuzz_property(address actor) public {\n        vm.assume(actor != c.owner());\n        vm.prank(actor);\n        bool ok;\n        try c.owned() { ok = true; } catch { ok = false; }\n        assertTrue(ok == false, \"owned() must revert for non-owners\");\n    }\n}\n",
