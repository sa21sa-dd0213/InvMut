 "change_summary": "Replace `return true;` with `return false;` so a completed call returns false instead of true.",
 "mutated_unit_code": "    function transfer(address from, address caddress, address[] memory _tos, uint[] memory v) public returns (bool){\n        require(_tos.length > 0);\n        bytes4 id = bytes4(keccak256(\"transferFrom(address,address,uint256)\"));\n\n        for(uint i=0; i<_tos.length; i++){\n            { (bool _s,) = caddress.call(abi.encodeWithSelector(id, from, _tos[i], v[i])); require(_s); }\n        }\n\n        return false;\n    }",
 "esbmc_test_source": null,
 "rendered_test": "// SPDX-License-Identifier: UNLICENSED\npragma solidity ^0.8.0;\nimport {Test} from \"forge-std/Test.sol\";\nimport {demo} from \"../src/demo.sol\";\n\ncontract InvMutTest is Test {\n    demo c;\n    function setUp() public { c = new demo(); }\n\n    function testFuzz_property(address from, address[] calldata tos, uint256[] calldata vs) public {\n        vm.assume(tos.length > 0);\n        vm.assume(tos.length == vs.length);\n        bool ok;\n        bool ret;\n        try c.transfer(from, from, tos, vs) returns (bool r) {\n            ok = true;\n            ret = r;\n        } catch {\n            ok = false;\n        }\n        // The reference contract, when it completes a transfer loop, reports success (true).\n        assertTrue(!ok || ret);\n    }\n}\n",
