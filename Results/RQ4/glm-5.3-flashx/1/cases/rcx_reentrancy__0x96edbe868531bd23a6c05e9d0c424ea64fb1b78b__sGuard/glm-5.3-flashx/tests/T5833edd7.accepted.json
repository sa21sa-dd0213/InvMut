 "rendered_test": "// SPDX-License-Identifier: UNLICENSED\npragma solidity ^0.8.0;\nimport {Test} from \"forge-std/Test.sol\";\nimport {PENNY_BY_PENNY} from \"../src/PENNY_BY_PENNY.sol\";\n\ncontract InvMutTest is Test {\n    PENNY_BY_PENNY c;\n    function setUp() public { c = new PENNY_BY_PENNY(); }\n    function testFuzz_property(uint256 val, address actor) public {\n        vm.assume(actor != address(0));\n        vm.prank(actor);\n        bool ok = true;\n        try c.SetMinSum(val) {\n            ok = true;\n        } catch {\n            ok = false;\n        }\n        if (ok) {\n            assertTrue(c.MinSum() == val);\n        } else {\n            assertTrue(true);\n        }\n    }\n}",
