 "change_summary": "Remove the `if(intitalized)revert();` guard so SetMinSum can update MinSum even after initialization.",
 "mutated_unit_code": "     function SetMinSum(uint _val)  public nonReentrant_ {\n        MinSum = _val;\n    }",
 "esbmc_test_source": "contract InvMutTest {\n    C c;\n    constructor() { c = new C(); }\n    function __ESBMC_reverted() internal returns (bool) {}\n    function __ESBMC_assume(bool) internal pure {}\n    receive() external payable {}\n\n    function test(uint v) public {\n        require(v > 0);\n        c.SetMinSum(v); if (__ESBMC_reverted()) return;\n        c.Initialized(); if (__ESBMC_reverted()) return;\n        bool reverted = false;\n        c.SetMinSum(0); bool __rev0 = __ESBMC_reverted(); if (__rev0) {\n            reverted = true;\n        } else {\n            reverted = false;\n        }\n        assert(reverted && c.MinSum() == v);\n    }\n}",
 "rendered_test": "// SPDX-License-Identifier: UNLICENSED\npragma solidity ^0.8.0;\n\nimport {Test} from \"forge-std/Test.sol\";\nimport {PENNY_BY_PENNY} from \"../src/PENNY_BY_PENNY.sol\";\n\ncontract InvMutTest is Test {\n    uint256 internal constant VALUE_CAP = 1000000000000000000000000000000;\n    PENNY_BY_PENNY c;\n\n    function setUp() public {\n        c = new PENNY_BY_PENNY();\n    }\n\n    function _test(uint256 v) internal {\n        vm.assume(v > 0);\n        try c.SetMinSum(v) {} catch { return; }\n        try c.Initialized() {} catch { return; }\n        bool reverted = false;\n        try c.SetMinSum(0) {\n            reverted = false;\n        } catch {\n            reverted = true;\n        }\n        assertTrue(reverted && c.MinSum() == v);\n    }\n\n    function testFuzz_test(uint256 v) public {\n        _test(v);\n    }\n\n    receive() external payable {}\n}\n",
