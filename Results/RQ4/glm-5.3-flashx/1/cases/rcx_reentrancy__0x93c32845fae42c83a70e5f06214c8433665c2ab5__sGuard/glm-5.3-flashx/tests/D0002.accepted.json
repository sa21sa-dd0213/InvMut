 "change_summary": "Delete the `locked_ = false;` statement so the guard never releases, causing all subsequent guarded calls to revert.",
 "mutated_unit_code": "modifier nonReentrant_() {\n    require(!locked_);\n    locked_ = true;\n    _;\n  }",
 "esbmc_test_source": "contract InvMutTest {\n    C c;\n    constructor() { c = new C(address(new Log())); }\n    function __ESBMC_reverted() internal returns (bool) {}\n    function __ESBMC_assume(bool) internal pure {}\n    function test(uint256 amt) public { __ESBMC_assume(address(c).balance >= 1000000000000000000000000); require(address(this).balance >= (amt) + (amt)); require(amt <= 1000000000000000000000000000000);\n        require(address(this).balance >= 2 * amt && amt > 0);\n        c.Put{value: amt}(0); if (__ESBMC_reverted()) return;\n        bool ok; c.Put{value: amt}(uint256(0)); bool __rev0 = __ESBMC_reverted(); if (__rev0) { ok = false; } else { ok = true; }\n        assert(ok);\n    }\n    receive() external payable {}\n    fallback() external payable {}\n}",
 "rendered_test": "// SPDX-License-Identifier: UNLICENSED\npragma solidity ^0.8.0;\n\nimport {Test} from \"forge-std/Test.sol\";\nimport {X_WALLET} from \"../src/X_WALLET.sol\";\n\ncontract InvMutTest is Test {\n    uint256 internal constant VALUE_CAP = 1000000000000000000000000000000;\n    X_WALLET c;\n\n    function setUp() public {\n        c = new X_WALLET(address(new Log()));\n    }\n\n    function _test(uint256 amt) internal {\n        amt = bound(amt, 0, 1000000000000000000000000000000);\n        amt = bound(amt, 0, 1000000000000000000000000000000);\n        vm.deal(address(this), VALUE_CAP + VALUE_CAP);\n        vm.deal(address(c), VALUE_CAP);\n        vm.assume(address(this).balance >= 2 * amt && amt > 0);\n        try c.Put{value: amt}(0) {} catch { return; }\n        bool ok;\n        try c.Put{value: amt}(uint256(0)) { ok = true; } catch { ok = false; }\n        assertTrue(ok);\n    }\n\n    function testFuzz_test(uint256 amt) public {\n        _test(amt);\n    }\n\n    receive() external payable {}\n\n    fallback() external payable {}\n}\n",
