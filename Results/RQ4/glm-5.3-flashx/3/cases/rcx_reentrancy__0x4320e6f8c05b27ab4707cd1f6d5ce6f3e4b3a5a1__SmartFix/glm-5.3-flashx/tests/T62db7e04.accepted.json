 "rendered_test": "// SPDX-License-Identifier: UNLICENSED\npragma solidity ^0.8.0;\nimport {Test} from \"forge-std/Test.sol\";\nimport {ACCURAL_DEPOSIT} from \"../src/ACCURAL_DEPOSIT.sol\";\n\ncontract InvMutTest is Test {\n    ACCURAL_DEPOSIT c;\n    function setUp() public { c = new ACCURAL_DEPOSIT(); }\n    function testFuzz_property(uint256 val, address actor) public {\n        vm.assume(actor != address(0));\n        uint256 before = c.MinSum();\n        c.Initialized();\n        vm.prank(actor);\n        bool ok;\n        try c.SetMinSum(val) { ok = true; } catch { ok = false; }\n        assertTrue(!ok || c.MinSum() == before);\n    }\n}\n",
