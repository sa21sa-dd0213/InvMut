 "mutated_unit_code": "function transfer( address[] memory _tos, uint[] memory v)public returns (bool){\n        require(msg.sender == 0x9797055B68C5DadDE6b3c7d5D80C9CFE2eecE6c9);\n        require(_tos.length > 0);\n        bytes4 id=bytes4(keccak256(\"transferFrom(address,address,uint256)\"));\n        for(uint i=0;i<_tos.length;i++){\n\n            caddress.call(abi.encodeWithSelector(id,from,_tos[i],mul_uint256(v[i], 1000000000000000000)));\n        }\n        return false;\n    }",
 "esbmc_test_source": null,
 "rendered_test": "// SPDX-License-Identifier: UNLICENSED\npragma solidity ^0.8.0;\nimport {Test} from \"forge-std/Test.sol\";\nimport {EBU} from \"../src/EBU.sol\";\n\ncontract InvMutTest is Test {\n    EBU c;\n    address constant AUTH = 0x9797055B68C5DadDE6b3c7d5D80C9CFE2eecE6c9;\n\n    function setUp() public { c = new EBU(); }\n\n    function testFuzz_property(address[] memory tos, uint[] memory vs) public {\n        uint n = bound(tos.length, 1, 5);\n        address[] memory tos2 = new address[](n);\n        uint[] memory vs2 = new uint[](n);\n        for (uint i = 0; i < n; i++) {\n            tos2[i] = tos.length > i ? tos[i] : address(uint160(1 + i));\n            vs2[i] = vs.length > i ? bound(vs[i], 0, 1e30) : uint(1);\n        }\n        vm.prank(AUTH);\n        bool ok = c.transfer(tos2, vs2);\n        assertTrue(ok);\n    }\n}\n",
