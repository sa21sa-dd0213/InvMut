 "rendered_test": "// SPDX-License-Identifier: UNLICENSED\npragma solidity ^0.8.0;\nimport {Test} from \"forge-std/Test.sol\";\nimport {Owned} from \"../src/Owned.sol\";\n\ncontract InvMutTest is Test {\n    Owned c;\n    function setUp() public { c = new Owned(); }\n    function testFuzz_property(address newOwner) public {\n        address currentOwner = c.owner();\n        vm.prank(currentOwner);\n        bool ok;\n        try c.transferOwnership(newOwner) { ok = true; } catch { ok = false; }\n        assertTrue(ok && c.owner() == newOwner);\n    }\n}",
