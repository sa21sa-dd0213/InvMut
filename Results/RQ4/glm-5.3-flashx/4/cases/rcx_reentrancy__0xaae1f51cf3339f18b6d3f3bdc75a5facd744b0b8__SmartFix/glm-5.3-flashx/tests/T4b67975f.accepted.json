 "rendered_test": "// SPDX-License-Identifier: UNLICENSED\npragma solidity ^0.8.0;\nimport {Test} from \"forge-std/Test.sol\";\nimport {DEP_BANK} from \"../src/DEP_BANK.sol\";\n\ncontract InvMutTest is Test {\n    DEP_BANK c;\n    function setUp() public { c = new DEP_BANK(); }\n    function testFuzz_property(uint256 val, address actor) public {\n        vm.assume(actor != address(0));\n        vm.prank(actor);\n        try c.SetMinSum(val) {\n            assertTrue(c.MinSum() == val, \"SetMinSum must set MinSum to val\");\n        } catch {\n            assertTrue(false, \"SetMinSum should not revert before initialization\");\n        }\n    }\n}",
