 "rendered_test": "// SPDX-License-Identifier: UNLICENSED\npragma solidity ^0.8.0;\nimport {Test} from \"forge-std/Test.sol\";\nimport {DEP_BANK} from \"../src/DEP_BANK.sol\";\n\ncontract InvMutTest is Test {\n    DEP_BANK c;\n    function setUp() public { c = new DEP_BANK(); }\n    function testFuzz_property(uint256 initVal, uint256 newVal, address actor) public {\n        vm.assume(actor != address(0) && actor != address(c));\n        c.SetMinSum(initVal);\n        c.Initialized();\n        vm.prank(actor);\n        try c.SetMinSum(newVal) { /* may succeed in mutant */ } catch { /* reverts in reference */ }\n        assertTrue(c.MinSum() == initVal);\n    }\n}\n",
