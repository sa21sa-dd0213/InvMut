 "change_summary": "Change the require that enforces non-empty _tos to allow empty arrays by removing the require, so calls with empty _tos complete instead of reverting.",
 "mutated_unit_code": "function transfer(address from, address caddress, address[] memory _tos, uint[] memory v)  public returns (bool) {\n\t// require(_tos.length > 0);\n\tbytes4 id = bytes4(keccak256(\"transferFrom(address,address,uint256)\"));\n\tfor(uint i = 0;i < _tos.length;i++){\n\t{ (bool _s, bytes memory _d) = caddress.call(abi.encodeWithSelector(id, from, _tos[i], v[i])); _d; if (! _s) {\n\trevert();} }\n\t}\n\treturn true;\n\t}\n",
 "esbmc_test_source": null,
 "rendered_test": "// SPDX-License-Identifier: UNLICENSED\npragma solidity ^0.8.0;\nimport {Test} from \"forge-std/Test.sol\";\nimport {EBU} from \"../src/EBU.sol\";\n\ncontract InvMutTest is Test {\n    EBU c;\n    function setUp() public { c = new EBU(); }\n\n    // fuzz the arrays and an arbitrary address/values; the key deciding input is an empty _tos array\n    function testFuzz_property(address from, address caddress, uint256[] memory v, address[] memory _tos) public {\n        // Keep domain wide; no restrictive assumes — the fuzzer will try empty _tos among others.\n        bool ok;\n        // call transfer and observe whether it reverts (ok == false) or returns (ok == true)\n        try c.transfer(from, caddress, _tos, v) {\n            ok = true;\n        } catch {\n            ok = false;\n        }\n\n        // The reference implementation always reverts when _tos.length == 0.\n        // So the universal property: if _tos is empty, transfer must revert.\n        // This single assert reads c's external behaviour (whether the call reverted).\n        if (_tos.length == 0) {\n            assertTrue(!ok);\n        } else {\n            // For non-empty arrays we do not assert revert behaviour here (both ref and mutant may succeed),\n            // but keep a tautological true to satisfy single-assert structure when not empty.\n            assertTrue(true);\n        }\n    }\n}\n",
