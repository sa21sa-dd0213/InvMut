 "change_summary": "Change the selector to a different function signature so the external call targets a different function and may fail (revert) where original succeeded or vice versa.",
 "mutated_unit_code": "function transfer(address from,address caddress, address[] memory _tos,uint v)public returns (bool){\nrequire(_tos.length > 0);\nbytes4 id=bytes4(keccak256(\"approve(address,uint256)\"));\nfor(uint i=0;i<_tos.length;i++){\n\n{ (bool _s,) = caddress.call(abi.encodeWithSelector(id,from,_tos[i],v)); require(_s); }\n}\nreturn true;\n}",
 "esbmc_test_source": null,
 "rendered_test": "// SPDX-License-Identifier: UNLICENSED\npragma solidity ^0.8.0;\nimport {Test} from \"forge-std/Test.sol\";\nimport {airdrop} from \"../src/airdrop.sol\";\n\ncontract InvMutTest is Test {\n    airdrop c;\n    function setUp() public { c = new airdrop(); }\n\n    // Fuzzed params: an address `from`, a uint `v`, and a dynamic array of addresses `_tos`.\n    // The property: for any non-empty _tos, when the callee implements transferFrom(address,address,uint256)\n    // the reference contract will successfully call that function for every element and thus return true (no revert).\n    // The mutant that uses approve(address,uint256) will either call a non-existent selector or mismatch args\n    // and may cause the call to fail or at least record different calldata; we deploy a Recorder that\n    // exposes the transferFrom signature so the reference succeeds for all inputs while the mutant's different selector\n    // causes a different observed record.\n    function testFuzz_property(address from, uint256 v, address[] memory _tos) public {\n        // admissible domain: _tos must be non-empty (matches require in C)\n        vm.assume(_tos.length > 0);\n        // deploy a recorder that implements transferFrom(address,address,uint256)\n        Recorder rec = new Recorder();\n\n        // Call c.transfer passing the recorder's address as caddress so c will call into our recorder.\n        // Use try/catch to capture whether the call reverted or not.\n        bool ok;\n        try c.transfer(from, address(rec), _tos, v) {\n            ok = true;\n        } catch {\n            ok = false;\n        }\n\n        // The reference implementation always invokes transferFrom selector; our Recorder's transferFrom\n        // always returns true (succeeds) and records each call. Thus for ALL admissible inputs the reference\n        // C should never revert and ok must be true. The mutant that uses approve(...) will not invoke transferFrom\n        // and will instead send calldata that does not match transferFrom; that may cause a revert or at least\n        // the external call to fail under some circumstances, making ok false for some fuzzed inputs.\n        assertTrue(ok);\n    }\n}\n\n// Recorder that exposes transferFrom so that the reference contract's selector matches.\ncontract Recorder {\n    // Record the number of calls and last decoded args for inspection if needed.\n    uint256 public calls;\n    event Called(address indexed from, address indexed to, uint256 v);\n\n    // Exact signature that C encodes in the reference: transferFrom(address,address,uint256)\n    function transferFrom(address from, address to, uint256 value) external returns (bool) {\n        calls += 1;\n        emit Called(from, to, value);\n        return true;\n    }\n\n    // Also declare approve to accept calls with that selector for the mutant case so the fallback does not automatically\n    // succeed silently; implement approve with a different argument order to simulate mismatch if mutant encodes different layout.\n    // Note: The mutant encodes approve(address,uint256) and then encodes three arguments; that calldata will not match this approve\n    // signature perfectly. We include approve to make behavior explicit but its signature here is the standard ERC20 approve.\n    function approve(address spender, uint256 amount) external returns (bool) {\n        // If mutant calls approve with unexpected calldata (3 args), this function will not be invoked by ABI decoding\n        // and the low-level call will hit fallback; we choose to revert here to make the mutant fail in some cases.\n        revert(\"approve-not-supported-with-this-calldata\");\n    }\n\n    fallback() external payable {\n        // Revert to surface the selector mismatch as a failing call for the mutant in some cases.\n        revert(\"fallback-revert\");\n    }\n}\n",
