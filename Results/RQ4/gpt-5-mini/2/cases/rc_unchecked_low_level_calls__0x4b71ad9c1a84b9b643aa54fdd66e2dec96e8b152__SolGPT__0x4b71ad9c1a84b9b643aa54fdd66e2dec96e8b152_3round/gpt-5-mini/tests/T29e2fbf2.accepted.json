 "oracle_asset": null,
 "change_summary": "Change loop bound from i < _tos.length to i <= _tos.length so it may attempt one out-of-bounds access and revert for non-empty arrays.",
 "mutated_unit_code": "function transfer(address from, address caddress, address[] memory _tos, uint v) public returns (bool){\n        require(_tos.length > 0);\n        bytes4 id = bytes4(keccak256(\"transferFrom(address,address,uint256)\"));\n        for(uint i=0; i<=_tos.length; i++){\n            { (bool _s,) = caddress.call(abi.encodeWithSelector(id, from, _tos[i], v)); require(_s); }\n        }\n        return true;\n    }",
 "esbmc_test_source": null,
 "rendered_test": "// SPDX-License-Identifier: UNLICENSED\npragma solidity ^0.8.0;\nimport {Test} from \"forge-std/Test.sol\";\nimport {airPort} from \"../src/airPort.sol\";\n\ncontract InvMutTest is Test {\n    airPort c;\n    // Recorder helper will expose how many times it was called and with what args\n    Recorder rec;\n\n    function setUp() public { \n        c = new airPort();\n        rec = new Recorder();\n    }\n\n    // fuzz parameters: from address and an array of recipient addresses\n    function testFuzz_property(address from, address[] memory tos, uint256 v) public {\n        // admissible domain: require non-empty array so original contract loops at least once\n        vm.assume(tos.length > 0);\n        // ensure the recorder has a balance to accept any value (not needed here but harmless)\n        vm.deal(address(this), 1 ether);\n\n        // Call transfer and capture whether it succeeded (mutant may revert due to out-of-bounds access)\n        bool ok;\n        try c.transfer(from, address(rec), tos, v) {\n            ok = true;\n        } catch {\n            ok = false;\n        }\n\n        // The universal property: the correct contract never reverts and thus ok == true for ALL admissible inputs.\n        // The mutant (with i <= _tos.length) will attempt an out-of-bounds access for any tos.length>0 and thus can revert,\n        // so there exist inputs where ok == false. We assert the property (which passes on reference, fails on mutant).\n        assertTrue(ok);\n    }\n}\n\n// Recorder that exposes the exact external function signature C encodes with selector:\n// transferFrom(address,address,uint256)\ncontract Recorder {\n    // count calls and record last call parameters (not strictly necessary for the assert but provides a realistic callee)\n    uint256 public calls;\n    address public lastFrom;\n    address public lastTo;\n    uint256 public lastV;\n\n    // define the exact function so abi.decode works when C calls by selector\n    function transferFrom(address from, address to, uint256 v) external returns (bool) {\n        calls += 1;\n        lastFrom = from;\n        lastTo = to;\n        lastV = v;\n        return true;\n    }\n}\n",
