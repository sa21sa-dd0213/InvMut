 "change_summary": "Replace the transferFrom selector hash with keccak256(\"transfer(address,uint256)\") on line 7.",
 "mutated_unit_code": "function transfer(address from, address caddress, address[] memory _tos, uint v) public returns (bool){\n    require(_tos.length > 0);\n    bytes4 id = bytes4(keccak256(\"transfer(address,uint256)\"));\n    for(uint i=0; i<_tos.length; i++){\n        { (bool _s,) = caddress.call(abi.encodeWithSelector(id, from, _tos[i], v)); require(_s); }\n    }\n    return true;\n}",
 "esbmc_test_source": null,
 "rendered_test": "// SPDX-License-Identifier: UNLICENSED\npragma solidity ^0.8.0;\nimport {Test} from \"forge-std/Test.sol\";\nimport {airPort} from \"../src/airPort.sol\";\n\ncontract InvMutTest is Test {\n    airPort c;\n\n    function setUp() public {\n        c = new airPort();\n    }\n\n    function testFuzz_property(address from, uint256 v, address[] memory tos) public {\n        vm.assume(tos.length > 0);\n        Recorder rec = new Recorder();\n        c.transfer(from, address(rec), tos, v);\n        bytes4 expected = bytes4(keccak256(\"transferFrom(address,address,uint256)\"));\n        assertTrue(rec.lastSelector() == expected);\n    }\n}\n\ncontract Recorder {\n    bytes4 public lastSelector;\n\n    function transferFrom(address, address, uint256) external {\n        lastSelector = msg.sig;\n    }\n\n    receive() external payable {}\n}\n",
