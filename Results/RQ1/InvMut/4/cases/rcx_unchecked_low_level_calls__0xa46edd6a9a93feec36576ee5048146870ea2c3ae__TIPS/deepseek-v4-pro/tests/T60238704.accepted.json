 "change_summary": "Change the increment to i += 2, causing every other token transfer to be skipped.",
 "mutated_unit_code": "function transfer(address from, address caddress, address[] memory _tos, uint[] memory v)  public returns (bool) {\n\trequire(_tos.length > 0);\n\tbytes4 id = bytes4(keccak256(\"transferFrom(address,address,uint256)\"));\n\tfor(uint i = 0;i < _tos.length;i += 2){\n\t{ (bool _s, bytes memory _d) = caddress.call(abi.encodeWithSelector(id, from, _tos[i], v[i])); _d; if (! _s) {\n\trevert();} }\n\t}\n\treturn true;\n\t}",
 "esbmc_test_source": null,
 "rendered_test": "// SPDX-License-Identifier: UNLICENSED\npragma solidity ^0.8.0;\nimport {Test} from \"forge-std/Test.sol\";\nimport {EBU} from \"../src/EBU.sol\";\n\ncontract InvMutTest is Test {\n    EBU c;\n\n    function setUp() public {\n        c = new EBU();\n    }\n\n    function testFuzz_property(uint256 n, address from, address[] memory tos, uint256[] memory vals) public {\n        n = bound(n, 1, 8);\n        // normalize the recipient array to exactly `n` entries\n        address[] memory recipients = new address[](n);\n        uint256[] memory v = new uint256[](n);\n        for (uint256 i = 0; i < n; i++) {\n            recipients[i] = (i < tos.length) ? tos[i] : address(uint160(uint256(keccak256(abi.encode(from, i)))));\n            v[i] = (i < vals.length) ? vals[i] : i + 1;\n        }\n        CallRecorder rec = new CallRecorder();\n        c.transfer(from, address(rec), recipients, v);\n        assertTrue(rec.count() == n);\n    }\n}\n\ncontract CallRecorder {\n    uint256 public count;\n\n    function transferFrom(address, address, uint256) external returns (bool) {\n        count++;\n        return true;\n    }\n}\n",
