 "change_summary": "Remove the `require(_s)` call-success check, so failed external calls no longer revert.",
 "mutated_unit_code": "function transfer(address from, address caddress, address[] memory _tos, uint v) public returns (bool){\n    require(_tos.length > 0);\n    bytes4 id = bytes4(keccak256(\"transferFrom(address,address,uint256)\"));\n    for(uint i=0; i<_tos.length; i++){\n        { (bool _s,) = caddress.call(abi.encodeWithSelector(id, from, _tos[i], v)); }\n    }\n    return true;\n}",
 "esbmc_test_source": null,
 "rendered_test": "// SPDX-License-Identifier: UNLICENSED\npragma solidity ^0.8.0;\nimport {Test} from \"forge-std/Test.sol\";\nimport {airPort} from \"../src/airPort.sol\";\n\ncontract InvMutTest is Test {\n    airPort c;\n    function setUp() public { c = new airPort(); }\n\n    function testFuzz_property(address from, address[] memory _tos, uint256 v) public {\n        vm.assume(_tos.length > 0);\n        Reverter reverter = new Reverter();\n        bool ok = true;\n        try c.transfer(from, address(reverter), _tos, v) returns (bool) {}\n        catch { ok = false; }\n        assertTrue(!ok);\n    }\n}\n\ncontract Reverter {\n    fallback() external payable { revert(); }\n}\n",
