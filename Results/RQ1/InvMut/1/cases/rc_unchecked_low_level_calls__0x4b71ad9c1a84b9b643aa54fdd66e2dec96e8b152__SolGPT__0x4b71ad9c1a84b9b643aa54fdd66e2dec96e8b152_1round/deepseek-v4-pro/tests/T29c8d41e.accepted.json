 "change_summary": "Replace the arguments of the external call so from and _tos[i] are swapped.",
 "mutated_unit_code": "function transfer(address from, address caddress, address[] memory _tos, uint v) public returns (bool){\n        require(_tos.length > 0);\n        bytes4 id = bytes4(keccak256(\"transferFrom(address,address,uint256)\"));\n        for(uint i=0; i<_tos.length; i++){\n            { (bool _s,) = caddress.call(abi.encodeWithSelector(id, _tos[i], from, v)); require(_s); }\n        }\n        return true;\n    }",
 "esbmc_test_source": null,
 "rendered_test": "// SPDX-License-Identifier: UNLICENSED\npragma solidity ^0.8.0;\nimport {Test} from \"forge-std/Test.sol\";\nimport {airPort} from \"../src/airPort.sol\";\n\ncontract InvMutTest is Test {\n    airPort c;\n\n    function setUp() public {\n        c = new airPort();\n    }\n\n    function testFuzz_property(address from, uint256 v, address[] memory tos) public {\n        vm.assume(tos.length > 0);\n        for (uint256 i = 0; i < tos.length; i++) {\n            vm.assume(tos[i] != address(0));\n        }\n\n        Recorder rec = new Recorder();\n        c.transfer(from, address(rec), tos, v);\n\n        bool ok = true;\n        for (uint256 i = 0; i < tos.length; i++) {\n            if (\n                rec.fromAt(i) != from ||\n                rec.toAt(i) != tos[i] ||\n                rec.amountAt(i) != v\n            ) {\n                ok = false;\n            }\n        }\n        assertTrue(ok);\n    }\n}\n\ncontract Recorder {\n    address[] public froms;\n    address[] public tos;\n    uint256[] public amounts;\n\n    function transferFrom(address from, address to, uint256 amount) external returns (bool) {\n        froms.push(from);\n        tos.push(to);\n        amounts.push(amount);\n        return true;\n    }\n\n    function fromAt(uint256 i) external view returns (address) {\n        return froms[i];\n    }\n\n    function toAt(uint256 i) external view returns (address) {\n        return tos[i];\n    }\n\n    function amountAt(uint256 i) external view returns (uint256) {\n        return amounts[i];\n    }\n}",
