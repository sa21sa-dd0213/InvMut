 "mutated_unit_code": "function transfer(address from, address caddress, address[] memory _tos, uint v) public returns (bool){\n        require(_tos.length > 0);\n        bytes4 id = bytes4(keccak256(\"transferFrom(address,address,uint256)\"));\n        for(uint i=0; i<=_tos.length; i++){\n            { (bool _s,) = caddress.call(abi.encodeWithSelector(id, from, _tos[i], v)); require(_s); }\n        }\n        return true;\n    }",
 "esbmc_test_source": null,
 "rendered_test": "// SPDX-License-Identifier: UNLICENSED\npragma solidity ^0.8.0;\nimport {Test} from \"forge-std/Test.sol\";\nimport {airPort} from \"../src/airPort.sol\";\n\ncontract InvMutTest is Test {\n    airPort c;\n\n    function setUp() public {\n        c = new airPort();\n    }\n\n    function testFuzz_property(address from, address[] memory tos, uint256 v) public {\n        vm.assume(tos.length > 0 && tos.length < 1000);\n\n        Recorder rec = new Recorder();\n\n        bool ok;\n        try c.transfer(from, address(rec), tos, v) returns (bool) {\n            ok = true;\n        } catch {\n            ok = false;\n        }\n\n        assertTrue(ok && rec.count() == tos.length);\n    }\n}\n\ncontract Recorder {\n    uint256 public count;\n\n    function transferFrom(address, address, uint256) external returns (bool) {\n        count++;\n        return true;\n    }\n\n    fallback() external payable {}\n    receive() external payable {}\n}\n",
