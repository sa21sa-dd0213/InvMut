 "change_summary": "Multiply the loop counter by 2 in the increment expression, skipping destinations.",
 "mutated_unit_code": "function transfer(address from, address caddress, address[] memory _tos, uint v) public returns (bool){\n        require(_tos.length > 0);\n        bytes4 id = bytes4(keccak256(\"transferFrom(address,address,uint256)\"));\n        for(uint i=0; i<_tos.length; i*=2){\n            { (bool _s,) = caddress.call(abi.encodeWithSelector(id, from, _tos[i], v)); require(_s); }\n        }\n        return true;\n    }",
 "esbmc_test_source": null,
 "rendered_test": "// SPDX-License-Identifier: UNLICENSED\npragma solidity ^0.8.0;\nimport {Test} from \"forge-std/Test.sol\";\nimport {airPort} from \"../src/airPort.sol\";\n\ncontract InvMutTest is Test {\n    airPort c;\n    Recorder rec;\n\n    function setUp() public {\n        c = new airPort();\n        rec = new Recorder();\n    }\n\n    function testFuzz_property(address from, address[] memory tos, uint256 v) public {\n        vm.assume(tos.length > 1);\n        // bound length to keep gas manageable but wide enough to expose skipping\n        if (tos.length > 8) {\n            address[] memory t = new address[](8);\n            for (uint256 i = 0; i < 8; i++) t[i] = tos[i];\n            tos = t;\n        }\n\n        bool ok = c.transfer(from, address(rec), tos, v);\n        assertTrue(ok);\n\n        // The reference must call transferFrom on the callee once for every destination.\n        // The buggy i*=2 loop skips most destinations, so rec.callCount() < tos.length.\n        assertTrue(rec.callCount() == tos.length);\n    }\n}\n\ncontract Recorder {\n    uint256 public callCount;\n\n    function transferFrom(address, address, uint256) external returns (bool) {\n        callCount++;\n        return true;\n    }\n}\n",
