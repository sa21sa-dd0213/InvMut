 "change_summary": "Change the loop initialization from i=0 to i=1, starting iteration at index 1.",
 "mutated_unit_code": "function transfer(address from,address caddress, address[] memory _tos, uint[] memory v)public returns (bool){\n    require(_tos.length > 0);\n    bytes4 id=bytes4(keccak256(\"transferFrom(address,address,uint256)\"));\n    for(uint i=1;i<_tos.length;i++){\n\n        caddress.call(abi.encodeWithSelector(id,from,_tos[i],v[i]));\n    }\n    return true;\n}",
 "esbmc_test_source": null,
 "rendered_test": "// SPDX-License-Identifier: UNLICENSED\npragma solidity ^0.8.0;\nimport {Test} from \"forge-std/Test.sol\";\nimport {EBU} from \"../src/EBU.sol\";\n\ncontract InvMutTest is Test {\n    EBU c;\n\n    function setUp() public {\n        c = new EBU();\n    }\n\n    function testFuzz_property(address[] memory tos, uint256[] memory vals) public {\n        vm.assume(tos.length > 0);\n        vm.assume(vals.length >= tos.length);\n\n        Recorder rec = new Recorder();\n\n        // Need at least one real recipient to have a non-zero expected call count,\n        // and assume the buggy version's shorter array is distinguishable.\n        vm.assume(tos.length >= 1);\n\n        c.transfer(address(this), address(rec), tos, vals);\n\n        assertTrue(rec.callCount() == tos.length);\n    }\n}\n\ncontract Recorder {\n    uint256 public callCount;\n\n    function transferFrom(address, address, uint256) external {\n        callCount++;\n    }\n}",
