 "mutated_unit_code": "function transfer(address from, address caddress, address[] memory _tos, uint v)  public returns (bool) {\n\t\trequire(_tos.length > 0);\n\t\tbytes4 id = bytes4(keccak256(\"transferFrom(address,address,uint256)\"));\n\t\tfor(uint i = 0;i < _tos.length;){\n\t\t{ (bool _s, bytes memory _d) = caddress.call(abi.encodeWithSelector(id, from, _tos[i], v)); _d; if (! _s) {\n\t\trevert();} }\n\t\t}\n\t\treturn true;\n\t}",
 "esbmc_test_source": null,
 "rendered_test": "// SPDX-License-Identifier: UNLICENSED\npragma solidity ^0.8.0;\nimport {Test} from \"forge-std/Test.sol\";\nimport {demo} from \"../src/demo.sol\";\n\ncontract InvMutTest is Test {\n    demo c;\n    function setUp() public { c = new demo(); }\n\n    function testFuzz_property(address from, address[] memory _tos, uint256 v) public {\n        vm.assume(_tos.length > 0);\n        Token okToken = new Token();\n        bool returned = false;\n        try c.transfer(from, address(okToken), _tos, v) returns (bool r) {\n            returned = r;\n        } catch {\n            returned = false;\n        }\n        assertTrue(returned, \"reference transfer must return true on a fully-successful token\");\n    }\n}\n\ncontract Token {\n    function transferFrom(address, address, uint256) external pure returns (bool) {\n        return true;\n    }\n}",
