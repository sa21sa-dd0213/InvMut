 "change_summary": "Initialize the loop counter to 1 instead of 0, skipping the first destination and changing the observed return behavior when the loop would otherwise execute for the first element.",
 "mutated_unit_code": "function transfer(address from,address caddress, address[] memory _tos,uint v)public returns (bool){\n        require(_tos.length > 0);\n        bytes4 id=bytes4(keccak256(\"transferFrom(address,address,uint256)\"));\n        for(uint i=1;i<_tos.length;i++){\n\n            caddress.call(abi.encodeWithSelector(id,from,_tos[i],v));\n        }\n        return true;\n    }",
 "esbmc_test_source": null,
 "rendered_test": "// SPDX-License-Identifier: UNLICENSED\npragma solidity ^0.8.0;\nimport {Test} from \"forge-std/Test.sol\";\nimport {demo} from \"../src/demo.sol\";\n\ncontract InvMutTest is Test {\n    demo c;\n\n    function setUp() public {\n        c = new demo();\n    }\n\n    function testFuzz_property(address from, address[] memory tos, uint256 v) public {\n        vm.assume(tos.length > 0);\n        Recorder rec = new Recorder();\n        c.transfer(from, address(rec), tos, v);\n        assertTrue(rec.count() == tos.length);\n    }\n}\n\ncontract Recorder {\n    uint256 public count;\n\n    function transferFrom(address, address, uint256) external returns (bool) {\n        count++;\n        return true;\n    }\n}",
