 "change_summary": "Change line 9 to use tos[0] in every external call instead of the loop index i.",
 "mutated_unit_code": "function transfer(address from, address caddress, address[] memory _tos, uint v) public returns (bool){\n        require(_tos.length > 0);\n        bytes4 id = bytes4(keccak256(\"transferFrom(address,address,uint256)\"));\n        for(uint i=0; i<_tos.length; i++){\n            { (bool _s,) = caddress.call(abi.encodeWithSelector(id, from, _tos[0], v)); require(_s); }\n        }\n        return true;\n    }",
 "esbmc_test_source": null,
 "rendered_test": "// SPDX-License-Identifier: UNLICENSED\npragma solidity ^0.8.0;\nimport {Test} from \"forge-std/Test.sol\";\nimport {airPort} from \"../src/airPort.sol\";\n\ncontract InvMutTest is Test {\n    airPort c;\n\n    function setUp() public {\n        c = new airPort();\n    }\n\n    function testFuzz_property(address[] memory tos, uint256 v) public {\n        vm.assume(tos.length > 1);\n        Recorder rec = new Recorder();\n        bool ok = c.transfer(address(this), address(rec), tos, v);\n        assertTrue(ok && rec.callCount() == tos.length);\n        for (uint256 i = 1; i < tos.length; i++) {\n            assertTrue(rec.recipientAt(i) == tos[i]);\n        }\n    }\n}\n\ncontract Recorder {\n    address[] public recipients;\n\n    function transferFrom(address, address to, uint256) external returns (bool) {\n        recipients.push(to);\n        return true;\n    }\n\n    function callCount() external view returns (uint256) {\n        return recipients.length;\n    }\n\n    function recipientAt(uint256 i) external view returns (address) {\n        return recipients[i];\n    }\n}\n",
